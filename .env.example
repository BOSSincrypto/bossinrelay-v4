# BossInRelay — пример окружения. Скопируй в .env и заполни.
# cp .env.example .env

# --- Админка (обязательно) ---
# Токен входа в дашборд. Сгенерируй: openssl rand -hex 32
ADMIN_TOKEN=changeme

# --- Клиентские ключи (релей выдаёт своим клиентам) ---
# Через запятую, формат sk-relay-...
CLIENT_API_KEYS=

# --- Ключи апстримов ---
# Формат: {PROVIDER}_KEYS (через запятую, порядок = порядку ключей в админке)
# или {PROVIDER}_API_KEY (один ключ). Поддерживаются провайдеры:
# OPENAI, ANTHROPIC, GEMINI, MISTRAL, DEEPSEEK, GROQ, OPENROUTER,
# OLLAMA, VLLM, LMSTUDIO.
OPENAI_KEYS=
ANTHROPIC_KEYS=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- База данных (libsql) ---
# По умолчанию — локальный файл ./data/relay.db, работает без сети.
LIBSQL_DB_PATH=./data/relay.db
# Для Turso Cloud задай ОБЕ переменные:
# LIBSQL_URL=libsql://твоя-база.turso.io
# LIBSQL_AUTH_TOKEN=

# --- Семантический кэш (второй уровень) ---
# Эмбеддинги для поиска похожих запросов. Без EMBED_API_KEY молча
# отключается и остаётся только точный кэш по SHA256.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-3-small
# SEMANTIC_CACHE_ENABLED=true
# CACHE_MAX_ENTRIES=10000

# --- Локальные модели ---
# Разрешить приватные/loopback адреса в base_url (Ollama, vLLM, LM Studio).
# ALLOW_PRIVATE_URLS=false

# --- Деплой на infrlo ---
# DOMAIN=твой-домен
# PORT=8000
